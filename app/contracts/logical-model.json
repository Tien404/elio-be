        "nullable": false
      },
      {
        "name": "email",
        "type": "text",
        "nullable": false
      },
      {
        "name": "full_name",
        "type": "text",
        "nullable": false
      },
      {
        "name": "password_hash",
        "type": "text",
        "nullable": false
      },
      {
        "name": "role",
        "type": "text",
        "nullable": false
      },
      {
        "name": "status",
        "type": "text",
        "nullable": false
      },
      {
        "name": "must_change_pwd",
        "type": "bool",
        "nullable": false
      },
      {
        "name": "created_by",
        "type": "int",
        "nullable": true
      },
      {
        "name": "created_at",
        "type": "timestamp",
        "nullable": false
      },
      {
        "name": "version",
        "type": "int",
        "nullable": false
      }
    ],
    "pk": [
      "user_id"
    ],
    "fk": [
      "created_by -> admins.user_id"
    ],
    "rules": [
      "UNIQUE email (case-insensitive normalized value)",
      "UNIQUE (user_id, role)",
      "role in STUDENT, INSTRUCTOR, ADMIN; status in ACTIVE, LOCKED",
      "Exactly one matching role subtype, enforced by account service transaction",
      "Only initial administrator bootstrap permits created_by NULL"
    ]
  },
  "students": {
