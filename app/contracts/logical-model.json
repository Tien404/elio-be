        "type": "int",
        "nullable": false
      },
      {
        "name": "sha256",
        "type": "text",
        "nullable": false
      },
      {
        "name": "state",
        "type": "text",
        "nullable": false
      },
      {
        "name": "uploaded_at",
        "type": "timestamp",
        "nullable": false
      },
      {
        "name": "expires_at",
        "type": "timestamp",
        "nullable": false
      }
    ],
    "pk": [
      "file_id"
    ],
    "fk": [
      "offering_id -> course_offerings.offering_id",
      "uploaded_by -> users.user_id",
      "assignment_id -> assignments.activity_id"
    ],
    "rules": [
      "UNIQUE file_key; state in STAGING, ATTACHED, EXPIRED",
      "purpose in MATERIAL, ASSIGNMENT_ATTACHMENT, SUBMISSION",
      "1 <= size_bytes <= 50000000 for MATERIAL; otherwise <= 20000000",
      "SUBMISSION requires assignment_id in the same offering",
      "expires_at = uploaded_at + 24 hours; expiry applies only to unattached staging",
      "Any file type; private download with attachment and nosniff; no execution/scanning promise",
      "Attach only with current authority and matching purpose/owner scope; reuse attached files only within same authorized parent/stream",
      "Never delete attached confirmed files via staging cleanup"
    ]
  },
