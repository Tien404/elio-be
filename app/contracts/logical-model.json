  },
  "submissions": {
    "group": 3,
    "fields": [
      {
        "name": "submission_id",
        "type": "int",
        "nullable": false
      },
      {
        "name": "assignment_id",
        "type": "int",
        "nullable": false
      },
      {
        "name": "owner_type",
        "type": "text",
        "nullable": false
      },
      {
        "name": "student_id",
        "type": "int",
        "nullable": true
      },
      {
