      "user_id -> users.user_id"
    ],
    "rules": [
      "UNIQUE (offering_id, user_id)",
      "UNIQUE offering_id where course_role = PRIMARY_INSTRUCTOR and status = ACTIVE",
      "Role must match user subtype; student suspension workflow excluded",
      "Teaching-team removal preserves authorship; service transaction preserves lead existence"
    ]
  },
  "topics": {
