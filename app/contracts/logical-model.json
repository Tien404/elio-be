    "fk": [
      "(activity_id, activity_type) -> activities.(activity_id, activity_type)"
    ],
    "rules": [
      "activity_type = ASSIGNMENT; open_at <= due_at <= cutoff_at",
      "Mode locks at publication; published due/cutoff may extend only before any saved grade/zero",
      "New confirmation requires OPEN offering, PUBLISHED assignment and open_at <= DB time <= cutoff_at",
      "Grading requires DB time > cutoff_at; no graded-work reopening"
    ]
  },
  "quizzes": {
    "group": 3,
    "fields": [
      {
        "name": "activity_id",
        "type": "int",
        "nullable": false
      },
      {
