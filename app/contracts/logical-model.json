      {
        "name": "duration_min",
        "type": "int",
        "nullable": false
      },
      {
        "name": "published_at",
        "type": "timestamp",
        "nullable": true
      }
    ],
    "pk": [
      "activity_id"
    ],
    "fk": [
      "(activity_id, activity_type) -> activities.(activity_id, activity_type)"
    ],
    "rules": [
      "activity_type = QUIZ; open_at < close_at; duration_min > 0",
      "Duration <= availability window; timing locks on first attempt",
      "Publication copies questions/options/keys/explanations/points atomically; max_score = sum(snapshot points)",
      "No manual quiz-score override or regrading"
    ]
  },
