    "fk": [
      "assignment_id -> assignments.activity_id",
      "student_id -> students.user_id",
      "(group_id, assignment_id) -> assignment_groups.(group_id, assignment_id)"
    ],
    "rules": [
      "UNIQUE (assignment_id, student_id) when student_id not NULL; UNIQUE group_id when not NULL",
      "Exactly one owner: INDIVIDUAL/student_id or GROUP/group_id",
      "status in NOT_SUBMITTED, SUBMITTED; no confirmed versions for missing-work zero container",
      "version is accepted stream version count, initially 0; versions are immutable",
      "Snapshot all assigned group members, including locked accounts, on first confirmation or reasoned zero; access checks remain current"
    ]
  },
  "submission_roster": {
    "group": 3,
    "fields": [
      {
        "name": "submission_id",
        "type": "int",
        "nullable": false
      },
      {
