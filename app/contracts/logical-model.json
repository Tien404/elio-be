      "created_by -> instructors.user_id"
    ],
    "rules": [
      "UNIQUE (course_id, semester, section_code)",
      "UNIQUE join_code when not NULL; six alphanumeric characters",
      "state in DRAFT, OPEN, ARCHIVED; join_code_enabled requires a code",
      "archived_at is non-null exactly while ARCHIVED",
      "Exactly one primary-instructor membership; active account required in DRAFT/OPEN",
      "Restoration requires active lead and preserves deadlines/history"
    ]
  },
  "course_memberships": {
    "group": 2,
    "fields": [
      {
        "name": "membership_id",
        "type": "int",
        "nullable": false
      },
      {
