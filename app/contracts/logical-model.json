      "material_id"
    ],
    "fk": [
      "student_id -> students.user_id",
      "material_id -> materials.material_id"
    ],
    "rules": []
  },
  "activities": {
    "group": 3,
    "fields": [
      {
        "name": "activity_id",
        "type": "int",
        "nullable": false
      },
      {
        "name": "offering_id",
        "type": "int",
        "nullable": false
      },
      {
        "name": "topic_id",
        "type": "int",
        "nullable": true
      },
      {
        "name": "activity_type",
        "type": "text",
        "nullable": false
      },
      {
        "name": "title",
        "type": "text",
        "nullable": false
      },
      {
        "name": "max_score",
        "type": "decimal",
        "nullable": false
      },
      {
        "name": "weight_pct",
        "type": "decimal",
        "nullable": false
      },
      {
        "name": "is_mandatory",
        "type": "bool",
        "nullable": false
      },
      {
        "name": "status",
        "type": "text",
        "nullable": false
      },
      {
        "name": "created_at",
        "type": "timestamp",
        "nullable": false
      },
      {
        "name": "version",
        "type": "int",
        "nullable": false
      }
    ],
    "pk": [
      "activity_id"
    ],
    "fk": [
      "offering_id -> course_offerings.offering_id",
      "(topic_id, offering_id) -> topics.(topic_id, offering_id)"
    ],
    "rules": [
      "UNIQUE (activity_id, activity_type); max_score > 0; 0 <= weight_pct <= 100",
      "Exactly one matching ASSIGNMENT/QUIZ subtype",
      "Optional topic is in same offering; preserve assessments if topic organization changes",
      "Gradebook final total requires all applicable published results and total weight 100; provisional contribution is not normalized"
    ]
  },
  "assignments": {
    "group": 3,
    "fields": [
      {
        "name": "activity_id",
        "type": "int",
        "nullable": false
      },
      {
        "name": "activity_type",
        "type": "text",
        "nullable": false
      },
      {
        "name": "instructions",
        "type": "text",
        "nullable": false
      },
      {
        "name": "open_at",
        "type": "timestamp",
        "nullable": false
      },
      {
        "name": "due_at",
        "type": "timestamp",
        "nullable": false
      },
      {
        "name": "cutoff_at",
        "type": "timestamp",
        "nullable": false
      },
      {
        "name": "is_group_work",
        "type": "bool",
