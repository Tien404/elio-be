ELIO_ENVIRONMENT=development
# Local development credentials; use private passwords in your .env.
MYSQL_PASSWORD=elio_dev_password
MYSQL_ROOT_PASSWORD=elio_dev_root_password
ELIO_DATABASE_URL=mysql://elio:elio_dev_password@127.0.0.1:3307/elio_dev
ELIO_DB_CONNECT_TIMEOUT_SECONDS=2
ELIO_DB_QUERY_TIMEOUT_SECONDS=5
ELIO_PRIVATE_FILES_DIR=./data/private
# Use a separate database whose name ends in _test. Tests delete its contents.
# ELIO_TEST_DATABASE_URL=mysql://elio_test:elio_test_password@127.0.0.1:13307/elio_test
# ELIO_SESSION_COOKIE_SECURE=true
# ELIO_SESSION_TTL_HOURS=12
# ELIO_CREDENTIAL_OUTBOX_DIR=./data/private/credential-outbox
