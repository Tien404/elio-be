# SQL Server connection. Keep credentials private.
ELIO_ENVIRONMENT=development
# Leave empty to run docs/live/501 stubs without a database.
ELIO_ODBC_CONNECTION_STRING=
# Set in your PRIVATE .env after installing the OS ODBC driver and creating the DB:
# ELIO_ODBC_CONNECTION_STRING='DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:127.0.0.1,1433;DATABASE=elio;UID=<app_user>;PWD=<replace_me>;Encrypt=yes;TrustServerCertificate=no;'
ELIO_DB_CONNECT_TIMEOUT_SECONDS=2
ELIO_DB_QUERY_TIMEOUT_SECONDS=5
ELIO_PRIVATE_FILES_DIR=./data/private
# CORS disabled; use a same-origin Vite /api proxy for local development.
# Isolated database for pytest integration tests (wiped before every test). Never your dev DB.
# ELIO_TEST_ODBC_CONNECTION_STRING='DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=elio_test;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;'
# Sessions (defaults shown). Secure cookies work on http://localhost in modern browsers.
# ELIO_SESSION_TTL_HOURS=12
# ELIO_SESSION_COOKIE_SECURE=true
# Temporary passwords are written here until a delivery channel is decided (API-G05).
# ELIO_CREDENTIAL_OUTBOX_DIR=./data/private/credential-outbox
